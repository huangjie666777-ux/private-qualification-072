{
  "name": "private-qualification",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:server": "tsx server/index.ts",
    "circom": "circom2",
    "setup:circuit": "bash scripts/build-circuit.sh",
    "setup:credentials": "tsx scripts/generate-credentials.ts",
    "setup": "npm run setup:circuit && npm run setup:credentials",
    "prove": "tsx scripts/prove-cli.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --import tsx server/index.ts",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "express": "4.21.2",
    "snarkjs": "0.7.6",
    "circomlib": "2.0.5",
    "circomlibjs": "0.1.7"
  },
  "devDependencies": {
    "circom2": "0.2.23",
    "tsx": "4.19.3",
    "@types/node": "22.13.10",
    "@types/express": "4.17.21",
    "typescript": "5.8.3",
    "vite": "6.2.0",
    "vitest": "3.0.8",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4"
  }
}
